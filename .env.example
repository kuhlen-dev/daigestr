# ============================================================
# Daigestr — Document Intelligence Service v3.1.0
# Copy this file to .env and fill in your values
# ============================================================

# ------------------------------------------------------------
# Mistral API (required for Vision, OCR, Classify, Extract)
# Get your key at: https://console.mistral.ai/api-keys/
# ------------------------------------------------------------
MISTRAL_API_KEY=your-api-key-here
MISTRAL_API_URL=https://api.mistral.ai/v1

# Models — use *-latest aliases to stay current automatically
# For maximum quality: mistral-large-latest ($0.50/1M tokens)
# For speed/cost: mistral-small-latest (~$0.15/1M tokens)
MISTRAL_VISION_MODEL=mistral-large-latest
MISTRAL_TEXT_MODEL=mistral-large-latest
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_OCR_ENABLED=true
MISTRAL_TIMEOUT=120

# ------------------------------------------------------------
# Token Limits (generous — you only pay per consumed token)
# ------------------------------------------------------------
VISION_MAX_TOKENS=16384
CLASSIFY_MAX_TOKENS=1024
EXTRACT_MAX_TOKENS=16384
OCR_CORRECT_MAX_TOKENS=16384

# Text input limits (characters sent to LLM)
CLASSIFY_MAX_CHARS=32000
EXTRACT_MAX_CHARS=32000

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
MCP_PORT=8080
MCP_TRANSPORT=sse
REST_PORT=8081
BIND_HOST=0.0.0.0

# ------------------------------------------------------------
# Limits
# ------------------------------------------------------------
MAX_FILE_SIZE_MB=25
MAX_RETRIES=3

# ------------------------------------------------------------
# Language
# ------------------------------------------------------------
DEFAULT_LANGUAGE=de

# ------------------------------------------------------------
# Image Processing
# ------------------------------------------------------------
IMAGE_MAX_WIDTH=2048
MIN_IMAGE_SIZE_PX=50
PDF_RENDER_DPI=200
SCAN_THRESHOLD_CHARS=50

# ------------------------------------------------------------
# Timeouts (seconds)
# ------------------------------------------------------------
PDFTOTEXT_TIMEOUT=60
PDFINFO_TIMEOUT=30
FFMPEG_TIMEOUT=600

# ------------------------------------------------------------
# Audio / Video (Whisper — runs locally on CPU, no API needed)
# Models: tiny, base, small, medium, large (larger = better but slower)
# ------------------------------------------------------------
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# ------------------------------------------------------------
# Directories (container paths)
# ------------------------------------------------------------
DATA_DIR=/data
TEMP_DIR=/tmp/markitdown

# ------------------------------------------------------------
# File Handling
# ------------------------------------------------------------
SKIP_FILES=email.md,consolidated.md,metadata.json,.DS_Store,Thumbs.db

# ------------------------------------------------------------
# Classification
# ------------------------------------------------------------
# Comma-separated list of document categories for classify tool
CLASSIFY_CATEGORIES=invoice,contract,cv,protocol,letter,technical_doc,report,presentation,spreadsheet,other
# Cache TTL in seconds for classify categories loaded from Template Registry
CLASSIFY_CACHE_TTL=300

# ------------------------------------------------------------
# Template Registry
# ------------------------------------------------------------
# Path to SQLite DB for the template registry (inside container)
TEMPLATES_DB_PATH=/data/templates.db
