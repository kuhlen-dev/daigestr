# ============================================================
# Daigestr — Document Intelligence Service v16.2.4
# Copy this file to .env and fill in your values
# ============================================================

# ------------------------------------------------------------
# Mistral API (required for Vision, OCR, Classify, Extract)
# Get your key at: https://console.mistral.ai/api-keys/
# ------------------------------------------------------------
MISTRAL_API_KEY=your-api-key-here
MISTRAL_API_URL=https://api.mistral.ai/v1

# Models — use *-latest aliases to stay current automatically
# For maximum quality: mistral-large-latest ($0.50/1M tokens)
# For speed/cost: mistral-small-latest (~$0.15/1M tokens)
MISTRAL_VISION_MODEL=mistral-large-latest
MISTRAL_TEXT_MODEL=mistral-large-latest
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_OCR_ENABLED=true
MISTRAL_OCR_TABLE_FORMAT=
MISTRAL_OCR_INCLUDE_IMAGE_BASE64=false
MISTRAL_OCR_DOCUMENT_ANNOTATION_FORMAT=
MISTRAL_OCR_BBOX_ANNOTATION_FORMAT=
MISTRAL_OCR_EXTRACT_HEADER=false
MISTRAL_OCR_EXTRACT_FOOTER=false
MISTRAL_OCR_CONFIDENCE_GRANULARITY=page
MISTRAL_TIMEOUT=120

# ------------------------------------------------------------
# Token Limits (generous — you only pay per consumed token)
# ------------------------------------------------------------
VISION_MAX_TOKENS=16384
CLASSIFY_MAX_TOKENS=1024
EXTRACT_MAX_TOKENS=16384
OCR_CORRECT_MAX_TOKENS=16384
MISTRAL_EXTRACT_RESPONSE_FORMAT=json_schema

# Text input limits (characters sent to LLM)
CLASSIFY_MAX_CHARS=32000
EXTRACT_MAX_CHARS=32000

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
MCP_PORT=8080
MCP_TRANSPORT=sse
REST_PORT=8081
BIND_HOST=0.0.0.0
MCP_HOST_BIND=0.0.0.0
MCP_HOST_PORT=18005
REST_HOST_BIND=0.0.0.0
REST_HOST_PORT=18006

# ------------------------------------------------------------
# Limits
# ------------------------------------------------------------
MAX_FILE_SIZE_MB=25
MAX_RETRIES=3
RATE_LIMIT_MAX_WAIT_SECONDS=60
QUALITY_RETRY_ENABLED=false
QUALITY_RETRY_THRESHOLD=0.75
QUALITY_RETRY_MODE=full

# ------------------------------------------------------------
# Language
# ------------------------------------------------------------
DEFAULT_LANGUAGE=de

# ------------------------------------------------------------
# Image Processing
# ------------------------------------------------------------
IMAGE_MAX_WIDTH=2048
# Maximum number of embedded images to describe per document (crash prevention)
MAX_DESCRIBE_IMAGES=50
# Policy threshold for treating a document as a long document
LONG_DOCUMENT_PAGE_THRESHOLD=25
MIN_IMAGE_SIZE_PX=50
PDF_RENDER_DPI=200
SCAN_THRESHOLD_CHARS=50

# ------------------------------------------------------------
# Timeouts (seconds)
# ------------------------------------------------------------
PDFTOTEXT_TIMEOUT=60
PDFINFO_TIMEOUT=30
FFMPEG_TIMEOUT=600
# Global timeout for a single convert operation (seconds)
# Optional: globaler convert_auto-Timeout in Sekunden.
# Leer lassen deaktiviert den Timeout vollständig.
CONVERT_TIMEOUT_SECONDS=
# Timeout for webhook delivery (seconds)
WEBHOOK_TIMEOUT_SECONDS=30

# ------------------------------------------------------------
# Audio / Video (Whisper — runs locally on CPU, no API needed)
# Models: tiny, base, small, medium, large (larger = better but slower)
# ------------------------------------------------------------
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# ------------------------------------------------------------
# Directories (container paths)
# ------------------------------------------------------------
DATA_DIR=/data
TEMP_DIR=/tmp/markitdown

# ------------------------------------------------------------
# File Handling
# ------------------------------------------------------------
SKIP_FILES=email.md,consolidated.md,metadata.json,.DS_Store,Thumbs.db

# ------------------------------------------------------------
# Classification
# ------------------------------------------------------------
DEFAULT_CLASSIFY=true
# Comma-separated list of document categories for classify tool
CLASSIFY_CATEGORIES=invoice,contract,cv,protocol,letter,technical_doc,report,presentation,spreadsheet,other
# Cache TTL in seconds for classify categories loaded from Template Registry
CLASSIFY_CACHE_TTL=300

# ------------------------------------------------------------
# PostgreSQL (eigener daigestr-postgres Container)
# ------------------------------------------------------------
POSTGRES_USER=daigestr
POSTGRES_PASSWORD=daigestr
POSTGRES_DB=daigestr
POSTGRES_HOST_PORT=15432
DATABASE_URL=postgresql://daigestr:daigestr@daigestr-postgres:5432/daigestr
# Connection pool size (psycopg2 ThreadedConnectionPool)
DB_POOL_MIN=1
DB_POOL_MAX=5
# DEPRECATED: TEMPLATES_DB_PATH=/data/templates.db (SQLite, wird in v6.0 entfernt)

# ------------------------------------------------------------
# Request-Level Cache
# ------------------------------------------------------------
# Cache identical requests to avoid redundant LLM/OCR calls
CACHE_ENABLED=true
# Time-to-live in seconds (default: 1 hour)
CACHE_TTL_SECONDS=3600

# ------------------------------------------------------------
# HTML Output (output_format='html')
# CDN URLs for Mermaid.js and highlight.js rendering
# Override to use self-hosted or pinned versions
# ------------------------------------------------------------
MERMAID_CDN_URL=https://cdn.jsdelivr.net/npm/mermaid/dist/mermaid.min.js
HIGHLIGHTJS_CDN_URL=https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js
HIGHLIGHTJS_CSS_URL=https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github.min.css

# ------------------------------------------------------------
# Audit Log (T-DAI-070)
# Tracks all conversion requests, steps, Mistral calls, warnings and responses
# ------------------------------------------------------------
# Enable/disable audit logging globally
AUDIT_ENABLED=true
# Number of days to retain audit log entries (cleanup via /v1/audit/cleanup or scheduled task)
AUDIT_RETENTION_DAYS=30
# Enable the audit REST API endpoints (/v1/audit/*)
AUDIT_API_ENABLED=true

# ------------------------------------------------------------
# Normalization (T-DAI-052)
# Controls field value normalization and canonical value resolution
# ------------------------------------------------------------
# Cache TTL for normalized lookups in seconds (default: 60s)
NORMALIZE_CACHE_TTL_SECONDS=60
# Enable/disable normalization cache
NORMALIZE_CACHE_ENABLED=true
# ISO 3166-1 alpha-2 fallback country code for address/IBAN normalization
NORMALIZE_FALLBACK_COUNTRY=DE
# Tolerance for numeric plausibility checks (e.g. sum-of-items vs. total discrepancy)
NORMALIZE_PLAUSIBILITY_TOLERANCE=0.01

# ------------------------------------------------------------
# Debug Snapshots / Zwischenstände (T-DAI-083)
# Persist markdown/extraction/normalization intermediates for replay/debugging
# Policies: all, failures, retries, low_quality, long_documents
# ------------------------------------------------------------
DEBUG_SNAPSHOTS_ENABLED=false
DEBUG_SNAPSHOTS_RETENTION_DAYS=14
DEBUG_SNAPSHOTS_POLICIES=failures,retries,long_documents,low_quality
DEBUG_SNAPSHOTS_LONG_DOCUMENT_PAGE_THRESHOLD=25
DEBUG_SNAPSHOTS_LOW_QUALITY_THRESHOLD=0.75
DEBUG_SNAPSHOTS_INCLUDE_MARKDOWN=true
DEBUG_SNAPSHOTS_INCLUDE_EXTRACTED=true
DEBUG_SNAPSHOTS_INCLUDE_NORMALIZED=true
DEBUG_SNAPSHOTS_INCLUDE_ERRORS=true
