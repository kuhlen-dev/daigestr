# Daigestr — Document Intelligence Service v7.0.0 — Vollständige Konfiguration
# ALLE Variablen explizit gesetzt — keine Code-Defaults

# === Mistral API ===
MISTRAL_API_KEY=WIL2WpEptRXbI3Z7g8VJ8KKCr3GY87HV
MISTRAL_API_URL=https://api.mistral.ai/v1
MISTRAL_VISION_MODEL=mistral-large-latest
MISTRAL_TEXT_MODEL=mistral-large-latest
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_OCR_ENABLED=true
MISTRAL_OCR_TABLE_FORMAT=
MISTRAL_OCR_INCLUDE_IMAGE_BASE64=false
MISTRAL_OCR_DOCUMENT_ANNOTATION_FORMAT=
MISTRAL_OCR_BBOX_ANNOTATION_FORMAT=
MISTRAL_OCR_EXTRACT_HEADER=false
MISTRAL_OCR_EXTRACT_FOOTER=false
MISTRAL_OCR_CONFIDENCE_GRANULARITY=page
MISTRAL_TIMEOUT=120

# === Token-Limits (großzügig — Kosten nur pro verbrauchtem Token) ===
VISION_MAX_TOKENS=16384
CLASSIFY_MAX_TOKENS=1024
EXTRACT_MAX_TOKENS=16384
OCR_CORRECT_MAX_TOKENS=16384

# === Text-Limits für LLM-Input (Zeichen) ===
CLASSIFY_MAX_CHARS=32000
EXTRACT_MAX_CHARS=32000

# === Server ===
MCP_PORT=8080
MCP_TRANSPORT=sse
REST_PORT=8081
BIND_HOST=0.0.0.0
MCP_HOST_BIND=0.0.0.0
MCP_HOST_PORT=18005
REST_HOST_BIND=0.0.0.0
REST_HOST_PORT=18006

# === Limits ===
MAX_FILE_SIZE_MB=25
MAX_RETRIES=3
QUALITY_RETRY_ENABLED=true
QUALITY_RETRY_THRESHOLD=0.75
QUALITY_RETRY_MODE=full
DEFAULT_CLASSIFY=true
DEBUG_SNAPSHOTS_ENABLED=true
DEBUG_SNAPSHOTS_RETENTION_DAYS=5
DEBUG_SNAPSHOTS_POLICIES=failures,low_quality,long_documents,retries
DEBUG_SNAPSHOTS_INCLUDE_MARKDOWN=true
DEBUG_SNAPSHOTS_INCLUDE_EXTRACTED=true
DEBUG_SNAPSHOTS_INCLUDE_NORMALIZED=true
DEBUG_SNAPSHOTS_INCLUDE_ERRORS=true

# === Sprache ===
DEFAULT_LANGUAGE=de

# === Bild-Verarbeitung ===
IMAGE_MAX_WIDTH=2048
LONG_DOCUMENT_PAGE_THRESHOLD=25
MIN_IMAGE_SIZE_PX=50
PDF_RENDER_DPI=200
SCAN_THRESHOLD_CHARS=50

# === Timeouts (Sekunden) ===
PDFTOTEXT_TIMEOUT=60
PDFINFO_TIMEOUT=30
FFMPEG_TIMEOUT=600

# === Whisper (Audio-Transkription) ===
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# === Logging ===
LOG_LEVEL=info
LOG_FORMAT=json

# === Dateien ===
DATA_DIR=/data
TEMP_DIR=/tmp/markitdown
ALLOWED_PATH_ROOTS=/data
ALLOW_SYMLINK_PATHS=false
SKIP_FILES=email.md,consolidated.md,metadata.json,.DS_Store,Thumbs.db

# === PostgreSQL ===
POSTGRES_USER=daigestr
POSTGRES_PASSWORD=daigestr
POSTGRES_DB=daigestr
POSTGRES_HOST_PORT=15432
DATABASE_URL=postgresql://daigestr:daigestr@daigestr-postgres:5432/daigestr

# === Version ===
DAIGESTR_VERSION=16.4.4
CONTRACT_VERSION=1.0
EXECUTION_DIAGNOSTICS_LIMIT=25
EXECUTION_STUCK_THRESHOLD_SECONDS=1800
NORMALIZATION_DRIFT_SAMPLE_LIMIT=20
CONVERT_TIMEOUT_SECONDS=43200
JOB_TIMEOUT_SECONDS=43200
